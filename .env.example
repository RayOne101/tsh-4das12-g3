# Copier ce fichier vers .env (ignore par git), puis adapter les valeurs si besoin.
# Pour Docker Compose, copier aussi ce fichier dans Backend/microservices/User/.env.

# --- PostgreSQL (Backend/microservices/User/docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Keycloak (Backend/microservices/User/docker-compose.yml) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=http://localhost:8085

# Base Keycloak : meme serveur PostgreSQL que User, base separee.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
# Local : laisser vide pour utiliser jdbc:postgresql://postgres-user:5432/keycloak
# Deploiement : jdbc:postgresql://<host>:5432/keycloak?sslmode=require
KEYCLOAK_DB_URL=
# Pool JDBC Keycloak (les offres managees limitent souvent les connexions)
KEYCLOAK_DB_POOL_INITIAL_SIZE=1
KEYCLOAK_DB_POOL_MIN_SIZE=1
KEYCLOAK_DB_POOL_MAX_SIZE=10

# --- Services Spring (IDE / shell) ---
KEYCLOAK_URL=http://localhost:8085
KEYCLOAK_ISSUER_URI=http://localhost:8085/realms/tsh
KEYCLOAK_CLIENT_SECRET=change-me
EUREKA_URL=http://localhost:8761/eureka/
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/tsh_users
GATEWAY_PORT=8083
# Dev : update + SQL muet. Hors developpement : JPA_DDL_AUTO=validate et un vrai outil de migration.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
