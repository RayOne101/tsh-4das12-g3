        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "duree", "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "auto" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 31,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "Latence HTTP P95 et Moyenne",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"$service\", uri!~\"/actuator.*\"}[1m])))", "legendFormat": "P95 {{uri}}", "refId": "A" },
        { "datasource": "Prometheus", "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"$service\", uri!~\"/actuator.*\"}[1m])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{job=\"$service\", uri!~\"/actuator.*\"}[1m])), 0.0001)", "legendFormat": "Moy {{uri}}", "refId": "B" }
      ]
    },

