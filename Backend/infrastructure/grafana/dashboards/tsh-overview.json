      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{job=\"$service\", uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{method}} {{uri}} [{{status}}]", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
