      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Threads JVM",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "jvm_threads_live_threads{job=\"user-service\"}", "legendFormat": "Threads actifs", "refId": "A" },
        { "datasource": "Prometheus", "expr": "jvm_threads_daemon_threads{job=\"user-service\"}", "legendFormat": "Threads daemon", "refId": "B" }
