      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Pool de connexions BDD (HikariCP)",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "hikaricp_connections_active{job=\"user-service\"}", "legendFormat": "Connexions actives", "refId": "A" },
        { "datasource": "Prometheus", "expr": "hikaricp_connections_idle{job=\"user-service\"}", "legendFormat": "Connexions inactives", "refId": "B" },
        { "datasource": "Prometheus", "expr": "hikaricp_connections_max{job=\"user-service\"}", "legendFormat": "Max connexions", "refId": "C" }
