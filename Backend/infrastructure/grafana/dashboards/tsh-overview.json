          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "id": 20,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Memoire JVM (Heap)",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "jvm_memory_used_bytes{job=\"user-service\", area=\"heap\"}", "legendFormat": "Utilise - {{id}}", "refId": "A" },
        { "datasource": "Prometheus", "expr": "jvm_memory_max_bytes{job=\"user-service\", area=\"heap\"}", "legendFormat": "Max - {{id}}", "refId": "B" }
      ]
    },
