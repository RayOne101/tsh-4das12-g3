          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 30,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "Requetes passant par la Gateway",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(http_server_requests_seconds_count{job=\"gateway\"}[1m])", "legendFormat": "{{method}} {{uri}} {{status}}", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 31,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "title": "Taux d'erreurs HTTP 5xx (Gateway)",
      "type": "gauge",
      "targets": [
        { "datasource": "Prometheus", "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"gateway\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"gateway\"}[5m]))", "legendFormat": "% erreurs", "refId": "A" }
      ]
    }
