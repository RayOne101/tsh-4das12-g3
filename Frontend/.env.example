# Copier ce fichier vers Frontend/.env (ignore par git).
# En developpement, laisser VITE_API_URL vide : le proxy Vite renvoie /api vers
# le Gateway sur http://localhost:8083.

# Base des appels API. Vide = /api (proxy Vite).
VITE_API_URL=/api

# true (defaut) : l'interface utilise les donnees de demonstration.
# false : le profil et l'envoi de photo passent par le backend (Keycloak requis).
VITE_USE_MOCKS=true

# --- Keycloak (OIDC Authorization Code + PKCE) ---
# Laisser VITE_KEYCLOAK_URL vide pour rester en connexion simulee.
# Renseigner l'URL publique du serveur pour activer la vraie connexion : les
# formulaires TSH envoient les identifiants a Keycloak (grant password), sans
# redirection vers la page de connexion du realm.
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=tsh
# Client de l'application etudiante.
VITE_KEYCLOAK_CLIENT_ID=tsh-web
# Client dedie de la console d'administration.
VITE_KEYCLOAK_ADMIN_CLIENT_ID=tsh-admin-web
