# Copier ce fichier vers Frontend/.env (ignore par git).
# En developpement, laisser VITE_API_URL vide : le proxy Vite renvoie /api vers
# le Gateway sur http://localhost:8083.

# Base des appels API. Vide = /api (proxy Vite).
VITE_API_URL=/api

# true (defaut) : l'interface utilise les donnees de demonstration.
# false : le profil et l'envoi de photo passent par le backend (Keycloak requis).
VITE_USE_MOCKS=true
